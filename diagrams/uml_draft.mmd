classDiagram

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
        MONTHLY
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
        +int rank
    }

    class PetOwner {
        +int owner_id
        +string name
        +string email
        +List~Pet~ pets
        +Optional~time~ available_start
        +Optional~time~ available_end
        +Optional~int~ daily_care_minutes
        +set_preferences(available_start, available_end, daily_care_minutes) None
        +add_pet(pet) None
        +remove_pet(pet) None
        +get_all_tasks() List~CareTask~
        +get_pet_for_task(task) Pet
        +get_routine_for_task(task) CareRoutine
        +view_todays_tasks() List~CareTask~
        +view_overdue_tasks() List~CareTask~
        +clear_overdue_tasks() None
    }

    class Pet {
        +int pet_id
        +string name
        +string species
        +string breed
        +Optional~date~ birthday
        +string photo
        +string pet_needs
        +string care_instructions
        +List~CareRoutine~ routines
        +update_profile(fields) None
        +get_care_routines() List~CareRoutine~
        +add_routine(routine) None
        +remove_routine(routine) None
    }

    class CareRoutine {
        +int routine_id
        +Optional~int~ pet_id
        +string title
        +Frequency frequency
        +int interval
        +int duration_minutes
        +Priority priority
        +string category
        +time scheduled_time
        +date start_date
        +Optional~date~ end_date
        +bool is_active
        +List~CareTask~ tasks
        +update_routine(fields) None
        +generate_tasks(range_start, range_end, first_only) List~CareTask~
        +add_task(scheduled_date_time) CareTask
        +complete_task(task) Optional~CareTask~
        +get_tasks() List~CareTask~
    }

    class CareTask {
        +int task_id
        +Optional~int~ routine_id
        +string title
        +datetime scheduled_date_time
        +datetime original_date_time
        +int duration_minutes
        +Priority priority
        +bool completion_status
        +bool is_rescheduled
        +datetime end_date_time
        +set_completion_status(completion_status) None
        +reschedule(new_date_time) None
    }

    class DailyPlan {
        +List~CareTask~ included
        +List~CareTask~ excluded
        +dict reasons
        +int completed_minutes
        +int planned_minutes
        +Optional~int~ remaining_minutes
    }

    class Scheduler {
        +PetOwner owner
        +sort_by_time(tasks) List~CareTask~
        +get_tasks() List~CareTask~
        +tasks_on(day) List~CareTask~
        +todays_tasks() List~CareTask~
        +generate_schedule(day) DailyPlan
        +build_daily_plan(day) DailyPlan
        +overdue_tasks() List~CareTask~
        +upcoming_tasks(days) List~CareTask~
        +filter_tasks(pet_name, completed) List~CareTask~
        +find_conflicts() List~List~CareTask~~
        +conflict_warning(group) string
        +next_free_slot(duration, after, exclude_task_id) datetime
        +mark_task_complete(task) Optional~CareTask~
    }

    PetOwner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" CareRoutine : has
    CareRoutine "1" *-- "0..*" CareTask : generates
    CareRoutine ..> Frequency : uses
    CareRoutine ..> Priority : uses
    CareTask ..> Priority : uses
    Scheduler --> PetOwner : gets tasks via get_all_tasks()
    PetOwner ..> Scheduler : view methods delegate to
    Scheduler ..> DailyPlan : builds
    DailyPlan --> CareTask : includes or excludes with reasons
